From 7bbd26ac9a1bc1a26d599e5a8d77b9a80ae714ef Mon Sep 17 00:00:00 2001
From: Nick Sl <335926735+nickslkr@users.noreply.github.com>
Date: Fri, 25 Sep 2026 20:01:39 +0300
Subject: [PATCH 05/22] dt-bindings: phy: add Allwinner A523 MIPI CSI-2
 receiver D-PHY

Document the MIPI CSI-2 receiver D-PHY found in Allwinner A523 family SoCs.

The PHY instance exposes a single MMIO resource and no dedicated interrupt, clock or reset resources. It is consumed through the Generic PHY framework with zero PHY cells.

Signed-off-by: Nick Sl <335926735+nickslkr@users.noreply.github.com>
---
 .../phy/allwinner,sun55i-a523-mipi-dphy.yaml  | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml
new file mode 100644
index 000000000..8e0f1193a
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/allwinner,sun55i-a523-mipi-dphy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A523 MIPI CSI-2 Receiver D-PHY
+
+maintainers:
+  - Chen-Yu Tsai <wens@csie.org>
+  - Maxime Ripard <mripard@kernel.org>
+
+properties:
+  compatible:
+    const: allwinner,sun55i-a523-mipi-dphy
+
+  reg:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    dphy2: phy@5810300 {
+        compatible = "allwinner,sun55i-a523-mipi-dphy";
+        reg = <0x05810300 0x100>;
+        #phy-cells = <0>;
+    };
+
+...
