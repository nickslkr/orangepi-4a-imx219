From acad184e22e546744b448a3ac685282c0ff4edab Mon Sep 17 00:00:00 2001
From: Nick Sl <335926735+nickslkr@users.noreply.github.com>
Date: Fri, 25 Sep 2026 21:22:57 +0300
Subject: [PATCH 09/22] arm64: dts: allwinner: a523: add CSI MCLK2 pinctrl

Add the PE15 pinctrl group for the A523 CSI master clock 2 output.

The vendor pinctrl data identifies PE15 mux 2 as the mipi2 function carrying mipi_mclk2. This is the master clock used by the Orange Pi 4A IMX219 camera configuration.

Signed-off-by: Nick Sl <335926735+nickslkr@users.noreply.github.com>
---
 arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index 3114c574d..e286e17f8 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -171,6 +171,14 @@ mipi2_2lane_pins: mipi2-2lane-pins {
 				drive-strength = <10>;
 			};
 
+			/omit-if-no-ref/
+			csi_mclk2_pin: csi-mclk2-pin {
+				pins = "PE15";
+				function = "mipi2";
+				allwinner,pinmux = <2>;
+				drive-strength = <20>;
+			};
+
 			mmc0_pins: mmc0-pins {
 				pins = "PF0" ,"PF1", "PF2", "PF3", "PF4", "PF5";
 				allwinner,pinmux = <2>;
-- 
