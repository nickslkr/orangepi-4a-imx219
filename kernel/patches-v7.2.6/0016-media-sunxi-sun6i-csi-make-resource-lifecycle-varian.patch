From 24aad47ec2a0cf27542d8ffb82ee7f57fe576d0a Mon Sep 17 00:00:00 2001
From: Nick Sl <335926735+nickslkr@users.noreply.github.com>
Date: Sun, 27 Sep 2026 13:38:17 +0300
Subject: [PATCH 16/22] media: sunxi: sun6i-csi: make resource lifecycle
 variant-specific

Signed-off-by: Nick Sl <335926735+nickslkr@users.noreply.github.com>

---
 .../platform/sunxi/sun6i-csi/sun6i_csi.c      | 78 ++++++++++++++-----
 .../platform/sunxi/sun6i-csi/sun6i_csi.h      |  9 +++
 2 files changed, 66 insertions(+), 21 deletions(-)

diff --git a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.c b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.c
index 791c468ef..9dcb9111a 100644
--- a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.c
+++ b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.c
@@ -170,20 +170,18 @@ static irqreturn_t sun6i_csi_interrupt(int irq, void *private)
 	return IRQ_HANDLED;
 }
 
-static int sun6i_csi_suspend(struct device *dev)
+static void
+sun6i_csi_legacy_runtime_suspend(struct sun6i_csi_device *csi_dev)
 {
-	struct sun6i_csi_device *csi_dev = dev_get_drvdata(dev);
-
 	reset_control_assert(csi_dev->reset);
 	clk_disable_unprepare(csi_dev->clock_ram);
 	clk_disable_unprepare(csi_dev->clock_mod);
-
-	return 0;
 }
 
-static int sun6i_csi_resume(struct device *dev)
+static int
+sun6i_csi_legacy_runtime_resume(struct sun6i_csi_device *csi_dev)
 {
-	struct sun6i_csi_device *csi_dev = dev_get_drvdata(dev);
+	struct device *dev = csi_dev->dev;
 	int ret;
 
 	ret = reset_control_deassert(csi_dev->reset);
@@ -215,6 +213,22 @@ static int sun6i_csi_resume(struct device *dev)
 	return ret;
 }
 
+static int sun6i_csi_suspend(struct device *dev)
+{
+	struct sun6i_csi_device *csi_dev = dev_get_drvdata(dev);
+
+	csi_dev->variant->hw_ops->runtime_suspend(csi_dev);
+
+	return 0;
+}
+
+static int sun6i_csi_resume(struct device *dev)
+{
+	struct sun6i_csi_device *csi_dev = dev_get_drvdata(dev);
+
+	return csi_dev->variant->hw_ops->runtime_resume(csi_dev);
+}
+
 static const struct dev_pm_ops sun6i_csi_pm_ops = {
 	.runtime_suspend	= sun6i_csi_suspend,
 	.runtime_resume		= sun6i_csi_resume,
@@ -227,21 +241,15 @@ static const struct regmap_config sun6i_csi_regmap_config = {
 	.max_register	= 0x9c,
 };
 
-static int sun6i_csi_resources_setup(struct sun6i_csi_device *csi_dev,
-				     struct platform_device *platform_dev)
+static int sun6i_csi_legacy_resources_setup(struct sun6i_csi_device *csi_dev,
+					    struct platform_device *platform_dev)
 {
 	struct device *dev = csi_dev->dev;
-	const struct sun6i_csi_variant *variant;
+	const struct sun6i_csi_variant *variant = csi_dev->variant;
 	void __iomem *io_base;
 	int ret;
 	int irq;
 
-	variant = of_device_get_match_data(dev);
-	if (!variant)
-		return -EINVAL;
-
-	csi_dev->variant = variant;
-
 	/* Registers */
 
 	io_base = devm_platform_ioremap_resource(platform_dev, 0);
@@ -300,10 +308,6 @@ static int sun6i_csi_resources_setup(struct sun6i_csi_device *csi_dev,
 		goto error_clock_rate_exclusive;
 	}
 
-	/* Runtime PM */
-
-	pm_runtime_enable(dev);
-
 	return 0;
 
 error_clock_rate_exclusive:
@@ -312,10 +316,38 @@ static int sun6i_csi_resources_setup(struct sun6i_csi_device *csi_dev,
 	return ret;
 }
 
+static void
+sun6i_csi_legacy_resources_cleanup(struct sun6i_csi_device *csi_dev)
+{
+	clk_rate_exclusive_put(csi_dev->clock_mod);
+}
+
+static int sun6i_csi_resources_setup(struct sun6i_csi_device *csi_dev,
+				     struct platform_device *platform_dev)
+{
+	struct device *dev = csi_dev->dev;
+	const struct sun6i_csi_variant *variant;
+	int ret;
+
+	variant = of_device_get_match_data(dev);
+	if (!variant)
+		return -EINVAL;
+
+	csi_dev->variant = variant;
+
+	ret = variant->hw_ops->resources_setup(csi_dev, platform_dev);
+	if (ret)
+		return ret;
+
+	pm_runtime_enable(dev);
+
+	return 0;
+}
+
 static void sun6i_csi_resources_cleanup(struct sun6i_csi_device *csi_dev)
 {
 	pm_runtime_disable(csi_dev->dev);
-	clk_rate_exclusive_put(csi_dev->clock_mod);
+	csi_dev->variant->hw_ops->resources_cleanup(csi_dev);
 }
 
 static int sun6i_csi_probe(struct platform_device *platform_dev)
@@ -390,6 +422,10 @@ static void sun6i_csi_remove(struct platform_device *pdev)
 }
 
 static const struct sun6i_csi_hw_ops sun6i_csi_legacy_hw_ops = {
+	.resources_setup	= sun6i_csi_legacy_resources_setup,
+	.resources_cleanup	= sun6i_csi_legacy_resources_cleanup,
+	.runtime_resume		= sun6i_csi_legacy_runtime_resume,
+	.runtime_suspend	= sun6i_csi_legacy_runtime_suspend,
 	.irq_enable		= sun6i_csi_bridge_irq_enable,
 	.irq_disable		= sun6i_csi_bridge_irq_disable,
 	.irq_clear		= sun6i_csi_bridge_irq_clear,
diff --git a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.h b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.h
index cb23037a5..1b0e83ccf 100644
--- a/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.h
+++ b/drivers/media/platform/sunxi/sun6i-csi/sun6i_csi.h
@@ -24,6 +24,8 @@ enum sun6i_csi_port {
 	SUN6I_CSI_PORT_ISP		= 2,
 };
 
+struct platform_device;
+
 struct sun6i_csi_buffer {
 	struct vb2_v4l2_buffer		v4l2_buffer;
 	struct list_head		list;
@@ -51,9 +53,16 @@ struct sun6i_csi_device {
 	bool                            isp_available;
 
 	const struct sun6i_csi_variant  *variant;
+	void                            *priv;
 };
 
 struct sun6i_csi_hw_ops {
+	int (*resources_setup)(struct sun6i_csi_device *csi_dev,
+			       struct platform_device *platform_dev);
+	void (*resources_cleanup)(struct sun6i_csi_device *csi_dev);
+	int (*runtime_resume)(struct sun6i_csi_device *csi_dev);
+	void (*runtime_suspend)(struct sun6i_csi_device *csi_dev);
+
 	void (*irq_enable)(struct sun6i_csi_device *csi_dev);
 	void (*irq_disable)(struct sun6i_csi_device *csi_dev);
 	void (*irq_clear)(struct sun6i_csi_device *csi_dev);
-- 
2.47.3

