 }
 
 static int sun6i_mipi_csi2_probe(struct platform_device *platform_dev)
@@ -722,6 +736,10 @@ static int sun6i_mipi_csi2_probe(struct platform_device *platform_dev)
 		return -ENOMEM;
 
 	csi2_dev->dev = dev;
+	csi2_dev->variant = device_get_match_data(dev);
+	if (!csi2_dev->variant)
+		return -EINVAL;
