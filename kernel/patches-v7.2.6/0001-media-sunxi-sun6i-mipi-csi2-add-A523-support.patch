+		if (ret) {
+			dev_err(dev, "failed to set mod clock rate\n");
+			return ret;
+		}
 	}
 
 	/* Reset */
@@ -698,7 +709,8 @@ sun6i_mipi_csi2_resources_setup(struct sun6i_mipi_csi2_device *csi2_dev,
 	return 0;
 
 error_clock_rate_exclusive:
-	clk_rate_exclusive_put(csi2_dev->clock_mod);
+	if (csi2_dev->variant->mod_rate)
+		clk_rate_exclusive_put(csi2_dev->clock_mod);
 
 	return ret;
 }
@@ -708,7 +720,9 @@ sun6i_mipi_csi2_resources_cleanup(struct sun6i_mipi_csi2_device *csi2_dev)
 {
 	pm_runtime_disable(csi2_dev->dev);
 	phy_exit(csi2_dev->dphy);
-	clk_rate_exclusive_put(csi2_dev->clock_mod);
