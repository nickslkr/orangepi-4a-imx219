From b8ac0d1446eb90e5f457e52082a36ce9460dda1d Mon Sep 17 00:00:00 2001
From: Nick Sl <335926735+nickslkr@users.noreply.github.com>
Date: Fri, 25 Sep 2026 21:39:57 +0300
Subject: [PATCH 11/22] arm64: dts: allwinner: orangepi-4a: enable I2C0

Enable I2C0 on the Orange Pi 4A using the PH0/PH1 pinctrl group at 400 kHz.

This bus is used by the board camera control interface.

Signed-off-by: Nick Sl <335926735+nickslkr@users.noreply.github.com>
---
 arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
index 055be86e5..908227ff2 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
@@ -119,6 +119,13 @@ &gpu {
 	status = "okay";
 };
 
+&i2c0 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0_ph_pins>;
+	status = "okay";
+};
+
 &mdio1 {
 	ext_rgmii_phy: ethernet-phy@1 {
 		compatible = "ethernet-phy-ieee802.3-c22";
-- 
2.47.3

