@@ -0,0 +1,111 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/allwinner,sun55i-a523-csi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A523 Camera Sensor Interface
+
+maintainers:
+  - Chen-Yu Tsai <wens@csie.org>
+  - Maxime Ripard <mripard@kernel.org>
+
+description:
+  The Allwinner A523 Camera Sensor Interface captures image data from a
+  MIPI CSI-2 receiver through the CSI parser and writes frames to memory
+  using the VIN DMA engine.
+
+properties:
+  compatible:
+    const: allwinner,sun55i-a523-csi
+
+  reg:
+    items:
+      - description: CSI top routing registers
+      - description: CSI parser registers
+      - description: VIN DMA registers
+
+  reg-names:
+    items:
+      - const: top
+      - const: parser
+      - const: dma
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: CSI bus clock
+      - description: CSI top clock
+      - description: CSI MBUS clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: top
+      - const: mbus
+
+  resets:
+    maxItems: 1
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: MIPI CSI-2 receiver input
+
+    required:
+      - port@1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - ports
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun55i-a523-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/sun55i-a523-ccu.h>
+
+    csi@5800800 {
+        compatible = "allwinner,sun55i-a523-csi";
+        reg = <0x05800800 0x200>,
+              <0x05822000 0x1000>,
+              <0x05830000 0x1000>;
+        reg-names = "top", "parser", "dma";
+
+        interrupts = <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>;
+
+        clocks = <&ccu CLK_BUS_CSI>,
+                 <&ccu CLK_CSI_TOP>,
+                 <&ccu CLK_MBUS_CSI>;
+        clock-names = "bus", "top", "mbus";
+
+        resets = <&ccu RST_BUS_CSI>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@1 {
+                reg = <1>;
+
+                csi_in: endpoint {
+                    remote-endpoint = <&mipi_csi2_out>;
+                };
+            };
+        };
+    };
+
+...
