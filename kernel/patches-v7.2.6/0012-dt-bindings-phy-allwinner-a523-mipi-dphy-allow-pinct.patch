From 37bda60ed3498c1df833d5c9c7f97294595ab2b0 Mon Sep 17 00:00:00 2001
From: Nick Sl <335926735+nickslkr@users.noreply.github.com>
Date: Fri, 25 Sep 2026 22:15:50 +0300
Subject: [PATCH 12/22] dt-bindings: phy: allwinner: a523-mipi-dphy: allow
 pinctrl

Allow the A523 MIPI D-PHY node to select its default pinctrl state.

The D-PHY owns the physical CSI-2 lane pins, so board device trees need to attach the lane pinmux to the PHY provider.

Signed-off-by: Nick Sl <335926735+nickslkr@users.noreply.github.com>
---
 .../bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml        | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml
index 8e0f1193a..40c7289e8 100644
--- a/Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun55i-a523-mipi-dphy.yaml
@@ -20,6 +20,11 @@ properties:
   "#phy-cells":
     const: 0
 
+  pinctrl-names:
+    const: default
+
+  pinctrl-0: true
+
 required:
   - compatible
   - reg
-- 
